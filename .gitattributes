# 统一换行符（Windows 编码 → 仓库内 LF），避免跨设备 diff 抖动
* text=auto eol=lf

# 图片/压缩包按二进制处理
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.zip binary
*.gz binary

# 文本类
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.svg text eol=lf
